{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "background": "#A9D3E9",
    "width": 1000,
    "height": 550,
    "layer": [
      {
        "data": {
          "url": "data/STE_2021_AUST_GDA2020.json",
          "format": {
            "type": "topojson",
            "feature": "STE_2021_AUST_GDA2020"
          }
        },
        "projection": {
          "type": "mercator"
        },
        "mark": {
          "type": "geoshape",
          "fill": "white",
          "stroke": "#888888",
          "strokeWidth": 0.6
        }
      },
      {
        "data": {
          "url": "data/Collaborative_Australian_Protected_Areas_Database_(CAPAD)_2024_-_Terrestrial__.csv"
        }, 
        "transform": [
          {"filter": "datum.STATE != 'EXT' && datum.STATE != 'JBT'"}
        ],
        "projection": {
          "type": "mercator"
        },
        "mark": "circle",
        "encoding": {
          "longitude": {
            "field": "LONGITUDE",
            "type": "quantitative"
          },
          "latitude": {
            "field": "LATITUDE",
            "type": "quantitative"
          },
          "tooltip": [
          {
          "field": "NAME",
          "type": "nominal",
          "title": "Name"
          },
          {
          "field": "STATE",
          "type": "nominal",
          "title": "State"
          }
          ],
          "size": {"value": 3},
          "color": {"value": "#c0392b"}
        }
      }
    ]
  }
  