{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "background": "#fcfaf6",
    "width": 1000,
    "height": 550,
    "layer": [
      {
        "data": {
          "url": "https://raw.githubusercontent.com/zzen0040/2179/refs/heads/main/data/STE_2016_AUST.json",
          "format": {
            "type": "topojson",
            "feature": "STE_2016_AUST"
          }
        },
        "projection": {
          "type": "mercator"
        },
        "mark": {
          "type": "geoshape",
          "fill": "#EFE8DC",
          "stroke": "#888888",
          "strokeWidth": 0.6
        }
      },
      {
        "data": {
          "url": "https://raw.githubusercontent.com/zzen0040/2179/refs/heads/main/data/Collaborative_Australian_Protected_Areas_Database_(CAPAD)_2024_-_Terrestrial__.csv"
        }, 
        "transform": [
          {"filter": "datum.STATE != 'EXT' && datum.STATE != 'JBT'"}
        ],
        "projection": {
          "type": "mercator"
        },
        "mark": "circle",
        "encoding": {
          "longitude": {
            "field": "LONGITUDE",
            "type": "quantitative"
          },
          "latitude": {
            "field": "LATITUDE",
            "type": "quantitative"
          },
          "tooltip": [
          {
          "field": "NAME",
          "type": "nominal",
          "title": "Name"
          },
          {
          "field": "STATE",
          "type": "nominal",
          "title": "State"
          }
          ],
          "size": {"value": 3},
          "color": {"value": "green"}
        }
      },
      {
        "data": {
          "values": [
            {
              "longitude": 127.4269153,
              "latitude": -24.5474574,
              "label": "Ngaanyatjarra"
            }
          ]
        },
        "mark": {
          "type": "point",
          "shape": "triangle",
           "angle": 180,
          "color": "orange",
          "filled": true,
          "size": 150
        },
        "encoding": {
          "longitude": {"field": "longitude"},
          "latitude": {"field": "latitude"}
        }
      },
      {
        "data": {
          "values": [
            {"label":"WA","longitude":121.5,"latitude":-25.5},
            {"label":"NT","longitude":133.5,"latitude":-19.5},
            {"label":"SA","longitude":135.5,"latitude":-30.0},
            {"label":"QLD","longitude":145.5,"latitude":-24.0},
            {"label":"NSW","longitude":147.0,"latitude":-32.5},
            {"label":"VIC","longitude":144.5,"latitude":-37.0},
            {"label":"TAS","longitude":146.5,"latitude":-42.0},
            {"label":"ACT","longitude":149.1,"latitude":-35.3},
            {"label":"Largest protected area","longitude":127.4269153,"latitude":-23.82474574}
          ]
        },
        "mark": {
          "type": "text",
          "fontSize":10,
          "fontWeight": "bold"
        },
        "encoding": {
          "longitude": {"field": "longitude"},
          "latitude": {"field": "latitude"},
          "text": {"field": "label"}
        }
      }
    ]
  }
  
