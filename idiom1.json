{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "background": "#A9D3E9",
    "width": 1000,
    "height": 550,
    "layer": [
      {
        "data": {
          "url": "data/STE_2016_AUST.json",
          "format": {
            "type": "topojson",
            "feature": "STE_2016_AUST"
          }
        },
        "projection": {
          "type": "mercator"
        },
        "mark": {
          "type": "geoshape",
          "fill": "#EFE8DC",
          "stroke": "#888888",
          "strokeWidth": 0.6
        }
      },
      {
        "data": {
          "url": "data/Collaborative_Australian_Protected_Areas_Database_(CAPAD)_2024_-_Terrestrial__.csv"
        }, 
        "transform": [
          {"filter": "datum.STATE != 'EXT' && datum.STATE != 'JBT'"}
        ],
        "projection": {
          "type": "mercator"
        },
        "mark": "circle",
        "encoding": {
          "longitude": {
            "field": "LONGITUDE",
            "type": "quantitative"
          },
          "latitude": {
            "field": "LATITUDE",
            "type": "quantitative"
          },
          "tooltip": [
          {
          "field": "NAME",
          "type": "nominal",
          "title": "Name"
          },
          {
          "field": "STATE",
          "type": "nominal",
          "title": "State"
          }
          ],
          "size": {"value": 3},
          "color": {"value": "green"}
        }
      },
      {
        "data": {
          "values": [
            {
              "longitude": 127.4269153,
              "latitude": -25.12474574,
              "label": "Ngaanyatjarra IPA"
            }
          ]
        },
        "mark": {
          "type": "point",
          "color": "orange",
          "filled": true,
          "size": 150
        }
      },
      {
        "data": {
          "values": [
            {
              "longitude": 132.4269153,
              "latitude": -27.12474574,
              "label": "Largest protected area"
            }
          ]
        },
        "mark": {
          "type": "text",
          "fontSize":10,
          "fontWeight": "bold"
        },
        "encoding": {
          "longitude": {"field": "longitude"},
          "latitude": {"field": "latitude"},
          "text": {"field": "label"}
        }
      }
    ]
  }
  