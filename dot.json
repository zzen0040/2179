{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "width": 500,
    "height": 400,
    "background": "#fcfaf6",
    "layer": 
    [
      {
    "data": {
      "url": "data/IBRA.csv"
    },
    "transform": [
      {"filter": "datum['1'] != 'Total'"},
      {
        "calculate": "toNumber(replace(datum['5'], /,/g, ''))",
        "as": "ibra_area"
      },
      {
        "calculate": "toNumber(replace(datum['6'], /,/g, ''))",
        "as": "protected_area"
      }
    ],
    "mark": {
      "type": "point",
      "filled": true,
      "opacity": 0.7,
      "color":"Green"
    },
    "encoding": {
      "x": {
        "field": "7",
        "type": "quantitative",
        "title": "% IBRA Region Protected"
      },
      "y": {
        "field": "protected_area",
        "type": "quantitative",
        "title": "Area Protected (ha)"
      },
      "size": {
        "field": "ibra_area",
        "type": "quantitative",
        "title": "IBRA Area (ha)"
      },
      "tooltip": [
        {"field": "1", "title": "IBRA Region"},
        {"field": "3", "title": "Jurisdiction"},
        {"field": "7", "title": "Protected %"},
        {"field": "protected_area", "title": "Protected Area"},
        {"field": "ibra_area", "title": "IBRA Area"}
      ]
    }
  },
  {
    "data": {
      "values": [
        {
          "x": 49.92,
          "y": 19709622,
          "label": "Largest protected area"
        }
      ]
    },
    "mark": {
      "type": "text",
      "dx":75,
      "fontSize": 12,
      "fontWeight": "bold"
    },
    "encoding": {
    "x": {"field": "x", "type": "quantitative"},
    "y": {"field": "y", "type": "quantitative"},
      "text": {"field": "label"}
    }
  },
  {
    "data": {
      "values": [
        {
          "x": 86.29,
          "y": 1350554,
          "label": "Highest protection rate"
        }
      ]
    },
    "mark": {
      "type": "text",
      "dy": 10,
      "dx": 30,
      "fontSize": 12,
      "fontWeight": "bold"
    },
    "encoding": {
    "x": {"field": "x", "type": "quantitative"},
    "y": {"field": "y", "type": "quantitative"},
      "text": {"field": "label"}
    }
  }
  ]
  }