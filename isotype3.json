{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "title": {"text": "Critically Endangered species","fontSize": 15,"fontWeight": "bold"},
    "background": "#fcfaf6",
    "config": {"view": {"stroke": ""}},
    "width": 400,
    "height": {
    "step": 40
    },
    "layer": [
      {
    "data": {"url":"data/species-list.csv"},
    "transform": [
    {
        "filter": "indexof(['Mammalia', 'Aves', 'Reptilia', 'Amphibia'], datum.class) >= 0"
    },
    {
        "filter": " datum.status =='Critically Endangered'"
    },
    {
        "calculate": "{'Mammalia': '🐨', 'Aves': '🦅', 'Reptilia': '🦎', 'Amphibia': '🐸'}[datum.class]",
        "as": "emoji"
      },
      {"window": [{"op": "rank", "as": "rank"}], "groupby": ["status", "class"]},
      {"calculate": "floor((datum.rank - 1) / 10)","as": "new_rank"}
    ],
    "mark": {"type": "text", "baseline": "middle"},
    "encoding": {
      "x": {"field": "new_rank","type": "quantitative","axis": null,"scale": {"domain": [0, 10]}},
      "y": {"field": "class", "type": "nominal", "axis": null, "sort":["Mammalia", "Aves", "Reptilia", "Amphibia"]},
      "text": {"field": "emoji", "type": "nominal"},
      "size": {"value": 30}
    }
  },
  {
    "data": {
      "values": [
        {"class":"Mammalia","label":"63"},
        {"class":"Aves","label":"89"},
        {"class":"Reptilia","label":"46"},
        {"class":"Amphibia","label":"23"}
      ]
    },

    "mark": {
      "type": "text",
      "align": "left",
      "baseline": "middle",
      "fontSize": 12,
      "fontWeight": "bold"
    },

    "encoding": {
      "x": {"value": 350},
      "y": {
        "field": "class",
        "type": "nominal",
        "sort": ["Mammalia", "Aves", "Reptilia", "Amphibia"]
      },
      "text": {"field": "label"}
    }
  }
  ]
  }
  